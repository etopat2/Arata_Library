# Copy only for local development; generate a random HEALTH_TOKEN with npm run foundation:init-env.
API_PORT=3000
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
REDIS_URL=redis://127.0.0.1:6379
HEALTH_TOKEN=replace-with-random-value-at-least-32-characters
AUTH_SESSION_SECRET=replace-with-64-random-hex-characters
AUTH_DATA_KEY=replace-with-64-random-hex-characters
# Configure a real SMTP relay in production; use Mailpit or another local sink for development.
# AUTH_SMTP_HOST=127.0.0.1
# AUTH_SMTP_PORT=1025
# AUTH_SMTP_USER=
# AUTH_SMTP_PASSWORD=
# AUTH_MAIL_FROM=accounts@example.invalid
# Registration stays disabled until approved legal document versions and URLs are configured.
# AUTH_TERMS_VERSION=
# AUTH_PRIVACY_VERSION=
# AUTH_TERMS_URL=
# AUTH_PRIVACY_URL=
# Local development billing uses Flutterwave v3 TEST mode. Keep credentials in ignored env files.
# Copy actual values from the test-mode dashboard; never use a live key for local development.
# FLUTTERWAVE_TEST_SECRET_KEY=
# FLUTTERWAVE_TEST_WEBHOOK_HASH=
# FLUTTERWAVE_TEST_ACCOUNT_ID=
# BILLING_JOBS_ENABLED=1
# Expiry notices and decision-log retention run every 15 minutes by default.
# ENTITLEMENT_JOBS_ENABLED=0  # Disable only if a separate maintenance scheduler owns these jobs.
# Production deployment requires a separate, explicitly approved live credential set and BILLING_LIVE_ENABLED=1.
# Never add live credentials to this development example or run automated tests against a live provider.
