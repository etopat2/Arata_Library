{
  "name": "arata-techlibrary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @arata/api\" \"npm run dev -w @arata/web-pwa\"",
    "dev:api": "npm run dev -w @arata/api",
    "dev:web": "npm run dev -w @arata/web-pwa",
    "dev:worker": "npm run dev -w @arata/worker",
    "foundation:init-env": "node infrastructure/scripts/init-foundation-env.mjs",
    "foundation:check": "npm run lint && npm run typecheck:foundation && npm run test:foundation && npm run build:foundation",
    "lint": "eslint apps packages tests --max-warnings=0 && prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx}\" --end-of-line auto",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck:foundation": "npm run build:packages && npm run typecheck -w @arata/api && npm run typecheck -w @arata/web-pwa && npm run typecheck -w @arata/worker",
    "test:foundation": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run tests/integration --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:studio": "playwright test --config playwright.studio.config.ts",
    "build:packages": "npm run build -w @arata/shared-types && npm run build -w @arata/validation && npm run build -w @arata/access-policy && npm run build -w @arata/api-client && npm run build -w @arata/ui",
    "build:foundation": "npm run build:packages && npm run build -w @arata/api && npm run build -w @arata/web-pwa && npm run build -w @arata/worker",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "tsx database/scripts/migrate-test.ts",
    "db:migrate:status": "prisma migrate status",
    "db:provision:dev": "tsx database/scripts/provision-dev.ts",
    "db:compose:init": "tsx database/scripts/init-compose.ts",
    "db:compose:provision": "tsx database/scripts/provision-compose.ts",
    "db:grant:dev": "tsx database/scripts/grant-dev.ts",
    "db:verify": "tsx database/scripts/verify-dev.ts",
    "db:identity:preflight": "tsx database/scripts/check-identity-preflight.ts",
    "identity:bootstrap-admin": "tsx database/scripts/bootstrap-admin.ts",
    "db:erd": "tsx database/scripts/generate-erd.ts",
    "db:test": "tsx --test database/tests/*.test.ts",
    "db:seed:dev": "tsx prisma/seed.dev.ts",
    "db:seed:catalogue:dev": "tsx prisma/seed.catalogue.dev.ts",
    "api:build": "python api/build_contracts.py",
    "api:validate": "python api/validate_contracts.py",
    "api:types": "openapi-typescript api/openapi.v1.yaml -o api/generated/v1.ts",
    "api:test": "python -m pytest -q api/tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "16.6.1",
    "multer": "2.5.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@viz-js/viz": "^3.17.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  }
}
