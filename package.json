{
  "name": "arata-techlibrary-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "tsx database/scripts/migrate-test.ts",
    "db:migrate:status": "prisma migrate status",
    "db:provision:dev": "tsx database/scripts/provision-dev.ts",
    "db:grant:dev": "tsx database/scripts/grant-dev.ts",
    "db:verify": "tsx database/scripts/verify-dev.ts",
    "db:erd": "tsx database/scripts/generate-erd.ts",
    "db:test": "tsx --test database/tests/*.test.ts",
    "db:seed:dev": "tsx prisma/seed.dev.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "16.6.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@viz-js/viz": "^3.17.0",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
