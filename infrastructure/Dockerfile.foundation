FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
COPY .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web-pwa/package.json apps/web-pwa/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/validation/package.json packages/validation/package.json
COPY packages/access-policy/package.json packages/access-policy/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN npm ci
COPY tsconfig.foundation.json ./
COPY apps ./apps
COPY packages ./packages
COPY infrastructure/scripts ./infrastructure/scripts
RUN npm run build:foundation
EXPOSE 3000 5173
