  editionId  String   @db.Uuid
  revisionId String   @db.Uuid
  anchor     String   @db.VarChar(500)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition    Edition  @relation(fields: [editionId], references: [id], onDelete: Restrict)
  revision   Revision @relation(fields: [revisionId, editionId], references: [id, editionId], onDelete: Restrict)

  @@unique([userId, revisionId, anchor])
  @@schema("app")
}

model Annotation {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  editionId        String   @db.Uuid
  revisionId       String   @db.Uuid
  anchor           String   @db.VarChar(500)
  encryptedBodyRef String   @db.VarChar(500)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition          Edition  @relation(fields: [editionId], references: [id], onDelete: Restrict)
  revision         Revision @relation(fields: [revisionId, editionId], references: [id, editionId], onDelete: Restrict)

  @@index([userId, revisionId])
  @@schema("app")
}

model Quiz {
  id          String         @id @default(uuid()) @db.Uuid
  lessonId    String         @db.Uuid
  revisionId  String         @db.Uuid
  version     Int
  title       String         @db.VarChar(300)
  publishedAt DateTime?      @db.Timestamptz(6)
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  revision    Revision       @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@unique([lessonId, version])
  @@schema("app")
}

model QuizQuestion {
  id            String       @id @default(uuid()) @db.Uuid
  quizId        String       @db.Uuid
  ordinal       Int
  kind          String       @db.VarChar(40)
  promptAssetId String?      @db.Uuid
  answerSpec    Json
  points        Int          @default(1)
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  answers       QuizAnswer[]

  @@unique([quizId, ordinal])
  @@schema("app")
}

model QuizAttempt {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  quizId      String        @db.Uuid
  status      AttemptStatus @default(STARTED)
  startedAt   DateTime      @default(now()) @db.Timestamptz(6)
  submittedAt DateTime?     @db.Timestamptz(6)
  score       Decimal?      @db.Decimal(8, 2)
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Restrict)
  answers     QuizAnswer[]

  @@index([userId, quizId, startedAt])
  @@schema("app")
}

model QuizAnswer {
  attemptId  String       @db.Uuid
  questionId String       @db.Uuid
  response   Json
  awarded    Decimal?     @db.Decimal(8, 2)
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@schema("app")
}

model Project {
  id           String              @id @default(uuid()) @db.Uuid
  lessonId     String              @db.Uuid
  version      Int
  title        String              @db.VarChar(300)
  briefAssetId String?             @db.Uuid
  lesson       Lesson              @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  submissions  ProjectSubmission[]

  @@unique([lessonId, version])
  @@schema("app")
}

model ProjectSubmission {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  userId      String   @db.Uuid
  assetId     String   @db.Uuid
  submittedAt DateTime @default(now()) @db.Timestamptz(6)
  status      String   @db.VarChar(40)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId, projectId])
  @@schema("app")
}

model OfflineLicence {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  editionId    String    @db.Uuid
  revisionId   String    @db.Uuid
  deviceHash   String    @db.VarChar(128)
  manifestHash String    @db.VarChar(128)
  issuedAt     DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime  @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  edition      Edition   @relation(fields: [editionId], references: [id], onDelete: Restrict)
  revision     Revision  @relation(fields: [revisionId, editionId], references: [id, editionId], onDelete: Restrict)

  @@index([userId, deviceHash, expiresAt])
  @@schema("app")
}

model SyncOperation {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  deviceHash        String   @db.VarChar(128)
  clientOperationId String   @db.VarChar(160)
  operationType     String   @db.VarChar(80)
  payloadHash       String   @db.VarChar(128)
  result            Json?
  processedAt       DateTime @default(now()) @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, clientOperationId])
  @@schema("app")
}

model Notification {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  kind         String             @db.VarChar(80)
  status       NotificationStatus @default(QUEUED)
  templateCode String             @db.VarChar(100)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  sentAt       DateTime?          @db.Timestamptz(6)
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@schema("app")
}

model ApprovalRequest {
  id                String          @id @default(uuid()) @db.Uuid
  kind              String          @db.VarChar(80)
  objectId          String          @db.Uuid
  requestedById     String          @db.Uuid
  decidedById       String?         @db.Uuid
  status            ApprovalStatus  @default(PENDING)
  reason            String
  requestedAt       DateTime        @default(now()) @db.Timestamptz(6)
  decidedAt         DateTime?       @db.Timestamptz(6)
  requestedBy       User            @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy         User?           @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  insightExceptions PublicInsight[]

  @@index([kind, objectId, status])
  @@schema("app")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  action        String   @db.VarChar(120)
  objectType    String   @db.VarChar(80)
  objectId      String?  @db.Uuid
  beforeHash    String?  @db.VarChar(128)
  afterHash     String?  @db.VarChar(128)
  correlationId String   @db.VarChar(120)
  reason        String?  @db.VarChar(1000)
  occurredAt    DateTime @default(now()) @db.Timestamptz(6)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([objectType, objectId, occurredAt])
  @@index([actorId, occurredAt])
  @@schema("app")
}

model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  aggregateType  String    @db.VarChar(80)
  aggregateId    String    @db.Uuid
  eventType      String    @db.VarChar(120)
  idempotencyKey String    @unique @db.VarChar(160)
  payload        Json
  occurredAt     DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt    DateTime? @db.Timestamptz(6)
  attemptCount   Int       @default(0)

  @@index([publishedAt, occurredAt])
  @@schema("app")
}

model PseudonymLink {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  pseudonym  String    @unique @db.VarChar(128)
  keyVersion String    @db.VarChar(40)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  rotatedAt  DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("research_private")
}

model ResearchSession {
  id             String          @id @default(uuid()) @db.Uuid
  pseudonym      String          @db.VarChar(128)
  startedAt      DateTime        @db.Timestamptz(6)
  endedAt        DateTime?       @db.Timestamptz(6)
  visibleSeconds Int             @default(0)
  engagedSeconds Int             @default(0)
  methodVersion  String          @db.VarChar(40)
  events         ResearchEvent[]

  @@index([pseudonym, startedAt])
  @@schema("research")
}

model ResearchEvent {
  id             String            @id @default(uuid()) @db.Uuid
  eventId        String            @unique @db.Uuid
  pseudonym      String            @db.VarChar(128)
  sessionId      String?           @db.Uuid
  purposeId      String            @db.Uuid
  publicationId  String?           @db.Uuid
  revisionId     String?           @db.Uuid
  eventType      String            @db.VarChar(100)
  schemaVersion  Int
  source         String            @db.VarChar(40)
  eventAt        DateTime          @db.Timestamptz(6)
  receivedAt     DateTime          @default(now()) @db.Timestamptz(6)
  retentionUntil DateTime          @db.Timestamptz(6)
  consentVersion String?           @db.VarChar(64)
  properties     Json
  session        ResearchSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  purpose        ProcessingPurpose @relation(fields: [purposeId], references: [id], onDelete: Restrict)
  publication    Publication?      @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  revision       Revision?         @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([eventType, eventAt])
  @@index([receivedAt], type: Brin, map: "research_event_received_brin")
  @@index([retentionUntil])
  @@index([pseudonym, eventAt])
  @@schema("research")
}

model ResearchMetric {
  id         String              @id @default(uuid()) @db.Uuid
  code       String              @db.VarChar(100)
  version    Int
  formula    String
  timezone   String              @db.VarChar(80)
  approvedAt DateTime?           @db.Timestamptz(6)
  aggregates ResearchAggregate[]

  @@unique([code, version])
  @@schema("research")
}

model ResearchAggregate {
  id             String         @id @default(uuid()) @db.Uuid
  metricId       String         @db.Uuid
  periodStart    DateTime       @db.Timestamptz(6)
  periodEnd      DateTime       @db.Timestamptz(6)
  dimensionsHash String         @db.VarChar(128)
  dimensions     Json
  value          Decimal        @db.Decimal(20, 6)
  sampleSize     Int
  computedAt     DateTime       @default(now()) @db.Timestamptz(6)
  metric         ResearchMetric @relation(fields: [metricId], references: [id], onDelete: Restrict)

  @@unique([metricId, periodStart, periodEnd, dimensionsHash])
  @@schema("research")
}

model ResearchStudy {
  id              String              @id @default(uuid()) @db.Uuid
  protocolVersion String              @db.VarChar(60)
  question        String
  status          ResearchStudyStatus @default(DRAFT)
  approvedAt      DateTime?           @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  reports         ResearchReport[]

  @@schema("research")
}

model ResearchReport {
  id            String               @id @default(uuid()) @db.Uuid
  studyId       String?              @db.Uuid
  metricVersion String               @db.VarChar(60)
  snapshotKey   String               @unique @db.VarChar(500)
  status        ResearchReportStatus @default(DRAFT)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  study         ResearchStudy?       @relation(fields: [studyId], references: [id], onDelete: Restrict)
  reviews       DisclosureReview[]
  insights      PublicInsight[]

  @@schema("research")
}

model DisclosureReview {
  id                String          @id @default(uuid()) @db.Uuid
  reportId          String          @db.Uuid
  reviewerId        String          @db.Uuid
  decision          ApprovalStatus
  minimumGroupSize  Int
  suppressionProof  Json
  differencingProof Json
  reviewedAt        DateTime        @default(now()) @db.Timestamptz(6)
  report            ResearchReport  @relation(fields: [reportId], references: [id], onDelete: Restrict)
  reviewer          User            @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  insights          PublicInsight[]

  @@index([reportId, reviewedAt])
  @@schema("research")
}

model PublicInsight {
  id                  String                   @id @default(uuid()) @db.Uuid
  reportId            String                   @db.Uuid
  reviewId            String                   @db.Uuid
  policyId            String                   @db.Uuid
  publishedById       String                   @db.Uuid
  exceptionApprovalId String?                  @db.Uuid
  snapshotKey         String                   @unique @db.VarChar(500)
  minimumGroupSize    Int
  publishedAt         DateTime                 @default(now()) @db.Timestamptz(6)
  withdrawnAt         DateTime?                @db.Timestamptz(6)
  report              ResearchReport           @relation(fields: [reportId], references: [id], onDelete: Restrict)
  review              DisclosureReview         @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  policy              ResearchDisclosurePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  publishedBy         User                     @relation(fields: [publishedById], references: [id], onDelete: Restrict)
  exceptionApproval   ApprovalRequest?         @relation(fields: [exceptionApprovalId], references: [id], onDelete: Restrict)

  @@index([publishedAt, withdrawnAt])
  @@schema("research")
}

model ResearchExport {
  id            String   @id @default(uuid()) @db.Uuid
  requestedById String   @db.Uuid
  purpose       String
  status        String   @db.VarChar(40)
  expiresAt     DateTime @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  requestedBy   User     @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([expiresAt, status])
  @@schema("research")
}

model ResearchDisclosurePolicy {
  id               String          @id @default(uuid()) @db.Uuid
  version          Int             @unique
  minimumGroupSize Int
  suppressionRule  String
  approvedAt       DateTime?       @db.Timestamptz(6)
  insights         PublicInsight[]

  @@schema("research")
}

model ResearchAudit {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(120)
  objectType String   @db.VarChar(80)
  objectId   String?  @db.Uuid
  purpose    String
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([objectType, objectId, occurredAt])
  @@schema("research")
}
