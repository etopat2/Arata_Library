generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "research", "research_private"]
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED

  @@schema("app")
}

enum AuthenticatorKind {
  PASSWORD
  TOTP
  PASSKEY
  RECOVERY_CODE

  @@schema("app")
}

enum PublicationKind {
  STANDALONE
  SERIES

  @@schema("app")
}

enum PublicationStatus {
  DRAFT
  FORTHCOMING
  PUBLISHED
  ARCHIVED
  WITHDRAWN

  @@schema("app")
}

enum RevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED

  @@schema("app")
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED

  @@schema("app")
}

enum AssetStatus {
  QUARANTINED
  SCANNING
  CLEAN
  APPROVED
  REJECTED
  ARCHIVED
  DELETED

  @@schema("app")
}

enum UploadStatus {
  INITIATED
  RECEIVING
  QUEUED
  PROCESSING
  CLEAN
  REJECTED
  EXPIRED

  @@schema("app")
}

enum ProcessingStatus {
  QUEUED
  RUNNING
  RETRY
  COMPLETE
  FAILED

  @@schema("app")
}

enum ImportStatus {
  PREVIEWING
  READY
  CONFIRMED
  PROCESSING
  COMPLETE
  FAILED

  @@schema("app")
}

enum ScheduleAction {
  PUBLISH
  WITHDRAW

  @@schema("app")
}

enum ScheduleStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  CANCELLED

  @@schema("app")
}

enum AccessClass {
  PUBLIC_FREE
  REGISTERED_FREE
  PREMIUM
  RESTRICTED

  @@schema("app")
}

enum ScreenshotPolicyMode {
  ALLOW
  WATERMARK
  RESTRICTED_NOTICE

  @@schema("app")
}

enum EntitlementSource {
  PAID
  TRIAL
  INSTITUTION
  COMPLIMENTARY
  SPONSORED

  @@schema("app")
}

enum EntitlementStatus {
  PENDING
  ACTIVE
  REVOKED

  @@schema("app")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@schema("app")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED

  @@schema("app")
}

enum PaymentStatus {
  INITIATED
  PENDING
  VERIFIED
  FAILED
  REVERSED

  @@schema("app")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  SUBMITTED
  SETTLED
  REJECTED

  @@schema("app")
}

enum InstitutionStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED

  @@schema("app")
}

enum MembershipStatus {
  PENDING
  VERIFIED
  SUSPENDED
  EXPIRED
  REJECTED

  @@schema("app")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXCEPTION

  @@schema("app")
}

enum AttemptStatus {
  STARTED
  SUBMITTED
  GRADED

  @@schema("app")
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED

  @@schema("app")
}

enum SubjectRequestStatus {
  OPEN
  VERIFYING
  PROCESSING
  COMPLETED
  REJECTED

  @@schema("app")
}

enum EntitlementScope {
  LIBRARY
  PUBLICATION
  VOLUME
  EDITION
  RESOURCE

  @@schema("app")
}

enum ResearchReportStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  RELEASED
  WITHDRAWN

  @@schema("research")
}

enum ResearchStudyStatus {
  DRAFT
  APPROVED
  PAUSED
  CLOSED

  @@schema("research")
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique @db.VarChar(320)
  passwordHash           String?                 @db.VarChar(255)
  status                 UserStatus              @default(ACTIVE)
  emailVerifiedAt        DateTime?               @db.Timestamptz(6)
  failedLoginCount       Int                     @default(0)
  lockedUntil            DateTime?               @db.Timestamptz(6)
  closedAt               DateTime?               @db.Timestamptz(6)
  termsAcceptedAt        DateTime?               @db.Timestamptz(6)
  termsVersion           String                  @default("LEGACY_UNRECORDED") @db.VarChar(64)
  privacyVersion         String                  @db.VarChar(64)
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  profile                UserProfile?
  sessions               AuthSession[]
  readerLeases           ReaderLease[]
  authenticators         Authenticator[]
  verificationTokens     VerificationToken[]
  roles                  RoleAssignment[]
  privacyPreferences     PrivacyPreference[]
  notificationPreference NotificationPreference?
  subjectRequests        SubjectRequest[]
  publications           Publication[]
  uploads                Asset[]
  editorialReviews       EditorialReview[]
  subscriptions          Subscription[]
  trialUsages            TrialUsage[]
  orders                 Order[]
  entitlements           Entitlement[]
  memberships            Membership[]
  cohortMemberships      CohortMember[]
  progress               ReadingProgress[]
  bookmarks              Bookmark[]
  annotations            Annotation[]
  quizAttempts           QuizAttempt[]
  projectSubmissions     ProjectSubmission[]
  offlineLicences        OfflineLicence[]
  syncOperations         SyncOperation[]
  notifications          Notification[]
  auditEvents            AuditEvent[]
  pseudonymLinks         PseudonymLink[]
  policyChanges          PolicyChange[]
  requestedGrants        GrantApproval[]         @relation("GrantRequester")
  approvedGrants         GrantApproval[]         @relation("GrantApprover")
  eligibilityReviews     EligibilityReview[]
  approvalsRequested     ApprovalRequest[]       @relation("ApprovalRequester")
  approvalsDecided       ApprovalRequest[]       @relation("ApprovalDecider")
  disclosureReviews      DisclosureReview[]
  researchExports        ResearchExport[]
  publishedInsights      PublicInsight[]
  researchAudits         ResearchAudit[]
  approvedDomains        InstitutionDomain[]
  createdRevisions       Revision[]              @relation("RevisionCreator")
  publishedRevisions     Revision[]              @relation("RevisionPublisher")
  rightsAttestations     RightsAttestation[]
  uploadSessions         UploadSession[]
  importJobs             ImportJob[]
  publicationSchedules   PublicationSchedule[]
  errata                 RevisionErratum[]

  @@schema("app")
}

model UserProfile {
  userId      String   @id @db.Uuid
  displayName String?  @db.VarChar(200)
  locale      String   @default("en-GB") @db.VarChar(32)
  timezone    String   @default("UTC") @db.VarChar(80)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("app")
}

model AuthSession {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  tokenHash     String        @unique @db.VarChar(128)
  expiresAt     DateTime      @db.Timestamptz(6)
  revokedAt     DateTime?     @db.Timestamptz(6)
  mfaVerifiedAt DateTime?     @db.Timestamptz(6)
  deviceLabel   String?       @db.VarChar(160)
  lastSeenAt    DateTime?     @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readerLeases  ReaderLease[]

  @@unique([id, userId])
  @@index([userId, expiresAt])
  @@schema("app")
}

model Authenticator {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  kind           AuthenticatorKind
  credentialHash String            @db.VarChar(512)
  credentialId   String?           @unique @db.VarChar(512)
  signCount      Int               @default(0)
  transports     String[]          @default([])
  confirmedAt    DateTime?         @db.Timestamptz(6)
  lastUsedAt     DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime?         @db.Timestamptz(6)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@schema("app")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  purpose   String    @db.VarChar(64)
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@schema("app")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  description String?
  assignments RoleAssignment[]
  permissions RolePermission[]

  @@schema("app")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String?
  roles       RolePermission[]

  @@schema("app")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@schema("app")
}

model RoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  scopeType String    @default("PLATFORM") @db.VarChar(32)
  scopeId   String?   @db.Uuid
  startsAt  DateTime  @default(now()) @db.Timestamptz(6)
  endsAt    DateTime? @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([userId, roleId, scopeType, scopeId])
  @@schema("app")
}

model ProcessingPurpose {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique @db.VarChar(80)
  description String
  lawfulBasis String              @db.VarChar(120)
  optional    Boolean             @default(false)
  preferences PrivacyPreference[]
  retention   RetentionPolicy[]
  events      ResearchEvent[]

  @@schema("app")
}

model PrivacyPreference {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @db.Uuid
  purposeId     String            @db.Uuid
  granted       Boolean
  policyVersion String            @db.VarChar(64)
  effectiveAt   DateTime          @default(now()) @db.Timestamptz(6)
  withdrawnAt   DateTime?         @db.Timestamptz(6)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       ProcessingPurpose @relation(fields: [purposeId], references: [id], onDelete: Restrict)

  @@index([userId, purposeId, effectiveAt])
  @@schema("app")
}

model NotificationPreference {
  userId    String   @id @db.Uuid
  email     Boolean  @default(true)
  inApp     Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("app")
}

model SubjectRequest {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @db.Uuid
  requestType String               @db.VarChar(40)
  status      SubjectRequestStatus @default(OPEN)
  reason      String?
  requestedAt DateTime             @default(now()) @db.Timestamptz(6)
  resolvedAt  DateTime?            @db.Timestamptz(6)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@schema("app")
}

model RetentionPolicy {
  id         String            @id @default(uuid()) @db.Uuid
  purposeId  String            @db.Uuid
  dataClass  String            @db.VarChar(80)
  days       Int?
  legalBasis String
  approvedAt DateTime?         @db.Timestamptz(6)
  version    Int
  purpose    ProcessingPurpose @relation(fields: [purposeId], references: [id], onDelete: Restrict)

  @@unique([purposeId, dataClass, version])
  @@schema("app")
}

model Library {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique @db.VarChar(200)
  title       String          @db.VarChar(300)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  collections Collection[]
  policies    ContentPolicy[]

  @@schema("app")
}

model Collection {
  id           String                  @id @default(uuid()) @db.Uuid
  libraryId    String                  @db.Uuid
  slug         String                  @unique @db.VarChar(200)
  title        String                  @db.VarChar(300)
  description  String?
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  library      Library                 @relation(fields: [libraryId], references: [id], onDelete: Restrict)
  publications PublicationCollection[]

  @@schema("app")
}

model PublicationCollection {
  publicationId String      @db.Uuid
  collectionId  String      @db.Uuid
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  collection    Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([publicationId, collectionId])
  @@schema("app")
}

model Publication {
  id                 String                   @id @default(uuid()) @db.Uuid
  slug               String                   @unique @db.VarChar(200)
  title              String                   @db.VarChar(400)
  subtitle           String?                  @db.VarChar(400)
  description        String?
  subject            String?                  @db.VarChar(160)
  keywords           String[]                 @default([])
  licenceCode        String?                  @db.VarChar(100)
  languageCode       String?                  @db.VarChar(35)
  sourceRef          String?                  @db.VarChar(500)
  releaseAt          DateTime?                @db.Timestamptz(6)
  featuredAt         DateTime?                @db.Timestamptz(6)
  kind               PublicationKind
  status             PublicationStatus        @default(DRAFT)
  ownerId            String                   @db.Uuid
  copyrightNotice    String?
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(6)
  owner              User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  collections        PublicationCollection[]
  contributors       PublicationContributor[]
  volumes            Volume[]
  editions           Edition[]
  resources          Resource[]
  policies           ContentPolicy[]
  entitlements       Entitlement[]
  researchEvents     ResearchEvent[]
  rights             RightsAttestation[]
  schedules          PublicationSchedule[]
  incomingReferences CrossReference[]
  uploadSessions     UploadSession[]

  @@index([status, kind])
  @@index([status, kind, subject, releaseAt], map: "publication_public_facet")
  @@index([featuredAt], map: "publication_featured_at")
  @@schema("app")
}

model Contributor {
  id           String                   @id @default(uuid()) @db.Uuid
  displayName  String                   @db.VarChar(240)
  slug         String                   @unique @db.VarChar(200)
  biography    String?
  publications PublicationContributor[]

  @@schema("app")
}

model PublicationContributor {
  publicationId String      @db.Uuid
  contributorId String      @db.Uuid
  role          String      @db.VarChar(60)
  ordinal       Int         @default(0)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Restrict)

  @@id([publicationId, contributorId, role])
  @@index([contributorId, role], map: "publication_contributor_person_role")
  @@schema("app")
}

model Volume {
  id            String          @id @default(uuid()) @db.Uuid
  publicationId String          @db.Uuid
  ordinal       Int
  title         String          @db.VarChar(400)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  publication   Publication     @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  editions      Edition[]
  resources     Resource[]
  policies      ContentPolicy[]
  entitlements  Entitlement[]

  @@unique([publicationId, ordinal])
  @@unique([id, publicationId])
  @@schema("app")
}

model Edition {
  id                String            @id @default(uuid()) @db.Uuid
  publicationId     String            @db.Uuid
  volumeId          String?           @db.Uuid
  ordinal           Int               @default(1)
  editionCode       String            @db.VarChar(60)
  label             String            @db.VarChar(200)
  isbn13            String?           @unique @db.VarChar(13)
  publicationDate   DateTime?         @db.Timestamptz(6)
  currentRevisionId String?           @db.Uuid
  isDefault         Boolean           @default(false)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  publication       Publication       @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  volume            Volume?           @relation(fields: [volumeId, publicationId], references: [id, publicationId], onDelete: Restrict)
  revisions         Revision[]        @relation("EditionRevisions")
  currentRevision   Revision?         @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  resources         Resource[]
  policies          ContentPolicy[]
  entitlements      Entitlement[]
  progress          ReadingProgress[]
  bookmarks         Bookmark[]
  annotations       Annotation[]
  offlineLicences   OfflineLicence[]
  imports           ImportJob[]

  @@index([publicationId, volumeId])
  @@index([publicationId, volumeId, ordinal], map: "edition_publication_volume_ordinal_idx")
  @@schema("app")
}

model Revision {
  id               String                @id @default(uuid()) @db.Uuid
  editionId        String                @db.Uuid
  number           Int
  status           RevisionStatus        @default(DRAFT)
  manifestHash     String?               @db.VarChar(128)
  changeSummary    String?
  correctionNotice String?
  createdById      String?               @db.Uuid
  publishedById    String?               @db.Uuid
  submittedAt      DateTime?             @db.Timestamptz(6)
  scheduledAt      DateTime?             @db.Timestamptz(6)
  publishedAt      DateTime?             @db.Timestamptz(6)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  edition          Edition               @relation("EditionRevisions", fields: [editionId], references: [id], onDelete: Restrict)
  creator          User?                 @relation("RevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publisher        User?                 @relation("RevisionPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  currentFor       Edition[]             @relation("CurrentRevision")
  chapters         Chapter[]
  reviews          EditorialReview[]
  resources        Resource[]
  policies         ContentPolicy[]
  quizzes          Quiz[]
  researchEvents   ResearchEvent[]
  bookmarks        Bookmark[]
  annotations      Annotation[]
  offlineLicences  OfflineLicence[]
  bibliography     BibliographyEntry[]
  rights           RightsAttestation[]
  errata           RevisionErratum[]
  schedules        PublicationSchedule[]
  importJobs       ImportJob[]

  @@unique([editionId, number])
  @@unique([id, editionId])
  @@schema("app")
}

model Chapter {
  id                 String           @id @default(uuid()) @db.Uuid
  revisionId         String           @db.Uuid
  ordinal            Int
  slug               String           @db.VarChar(200)
  title              String           @db.VarChar(400)
  previewText        String?
  summary            String?
  learningOutcomes   String[]         @default([])
  prerequisites      String[]         @default([])
  revision           Revision         @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  lessons            Lesson[]
  resources          Resource[]
  policies           ContentPolicy[]
  incomingReferences CrossReference[]

  @@unique([revisionId, ordinal])
  @@unique([revisionId, slug])
  @@schema("app")
}

model Lesson {
  id                 String            @id @default(uuid()) @db.Uuid
  chapterId          String            @db.Uuid
  ordinal            Int
  title              String            @db.VarChar(400)
  bodyAssetId        String?           @db.Uuid
  contentHash        String?           @db.VarChar(128)
  bodyMarkdown       String?
  blocks             Json?
  updatedAt          DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  chapter            Chapter           @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  bodyAsset          Asset?            @relation("LessonBody", fields: [bodyAssetId], references: [id], onDelete: Restrict)
  resources          Resource[]
  policies           ContentPolicy[]
  progress           ReadingProgress[]
  quizzes            Quiz[]
  projects           Project[]
  outgoingReferences CrossReference[]  @relation("CrossReferenceSource")
  incomingReferences CrossReference[]  @relation("CrossReferenceLessonTarget")

  @@unique([chapterId, ordinal])
  @@schema("app")
}

model BibliographyEntry {
  id           String   @id @default(uuid()) @db.Uuid
  revisionId   String   @db.Uuid
  citationKey  String   @db.VarChar(120)
  citationText String
  url          String?  @db.VarChar(2000)
  ordinal      Int
  revision     Revision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([revisionId, citationKey])
  @@unique([revisionId, ordinal])
  @@schema("app")
}

model CrossReference {
  id                  String       @id @default(uuid()) @db.Uuid
  sourceLessonId      String       @db.Uuid
  targetPublicationId String?      @db.Uuid
  targetChapterId     String?      @db.Uuid
  targetLessonId      String?      @db.Uuid
  label               String       @db.VarChar(300)
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  sourceLesson        Lesson       @relation("CrossReferenceSource", fields: [sourceLessonId], references: [id], onDelete: Restrict)
  targetPublication   Publication? @relation(fields: [targetPublicationId], references: [id], onDelete: Restrict)
  targetChapter       Chapter?     @relation(fields: [targetChapterId], references: [id], onDelete: Restrict)
  targetLesson        Lesson?      @relation("CrossReferenceLessonTarget", fields: [targetLessonId], references: [id], onDelete: Restrict)

  @@index([sourceLessonId])
  @@schema("app")
}

model RightsAttestation {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @db.Uuid
  revisionId    String      @db.Uuid
  actorId       String      @db.Uuid
  manifestHash  String      @db.VarChar(128)
  licenceCode   String      @db.VarChar(100)
  sourceRef     String      @db.VarChar(500)
  attestedAt    DateTime    @default(now()) @db.Timestamptz(6)
  revokedAt     DateTime?   @db.Timestamptz(6)
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  revision      Revision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  actor         User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([revisionId, manifestHash, revokedAt])
  @@schema("app")
}

model RevisionErratum {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @db.Uuid
  authorId   String   @db.Uuid
  notice     String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([revisionId, createdAt])
  @@schema("app")
}

model Asset {
  id                    String               @id @default(uuid()) @db.Uuid
  uploadedById          String               @db.Uuid
  storageKey            String               @unique @db.VarChar(500)
  originalName          String               @db.VarChar(400)
  mimeType              String               @db.VarChar(160)
  sizeBytes             BigInt
  sha256                String               @db.VarChar(64)
  status                AssetStatus          @default(QUARANTINED)
  scanEvidence          Json?
  scannedAt             DateTime?            @db.Timestamptz(6)
  licenceCode           String?              @db.VarChar(100)
  copyrightNotice       String?
  attribution           String?
  provenanceRef         String?              @db.VarChar(500)
  permissionConfirmedAt DateTime?            @db.Timestamptz(6)
  approvedAt            DateTime?            @db.Timestamptz(6)
  replacementOfId       String?              @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  uploadedBy            User                 @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  lessonBodies          Lesson[]             @relation("LessonBody")
  attachments           ResourceAttachment[]
  submissions           ProjectSubmission[]
  uploadSession         UploadSession?
  processingJob         AssetProcessingJob?
